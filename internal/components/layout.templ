package components

import "github.com/untanky/homepage/blog"

type HTMLData struct {
  Title string

  Scripts     []string
  Stylesheets []string
}

templ HTML(data HTMLData, body templ.Component) {
  <html>
    <head>
      <title>{data.Title}</title>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      for _, script := range data.Scripts {
      <script src={script}></script>
      }
      for _, stylesheet := range data.Stylesheets {
      <link rel="stylesheet" href={stylesheet} />
      }
    </head>
    <body>
      @body
    </body>
  </html>
}

type BlogListData struct {
  Blog  blog.Blog
  Posts []blog.PostMetadata
}

templ BlogList(data BlogListData) {
  <main class="max-w-[850px] mx-auto">
    <div class="bg-red-500/25 aspect-3/1 w-full"></div>
    <div class="max-w-[640px] px-4 mx-auto mt-6 space-y-2">
      <h1 class="text-5xl font-bold">
        {data.Blog.Title}
      </h1>
      <p class="text-gray-700 text-lg">
        {data.Blog.Summary}
      </p>
    </div>
    <div class="max-w-[640px] mx-auto mt-8 space-y-8">
      @List(data.Posts)
    </div>
  </main>
}

templ List(posts []blog.PostMetadata) {
  for _, post := range posts {
    <div class="space-y-2">
      <div class="bg-blue-500/25 aspect-3/1 w-full"></div>
      <div class="px-4 space-y-1">
        <h2 class="text-3xl font-semibold">
          {post.Title}
        </h2>
        <p class="text-gray-700 text-lg line-clamp-3">
          {post.Summary}
        </p>
      </div>
    </div>
  }
}
