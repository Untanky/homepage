package components

import (
  "context"
  "github.com/untanky/homepage/blog"
)

type pageConfig struct {
  title string

  scripts     []string
  stylesheets []string
}

type PageOption func(ctx context.Context, cfg *pageConfig)

func WithTitle(title string) PageOption {
  return func(ctx context.Context, cfg *pageConfig) {
     cfg.title = title
  }
}

func WithScript(scriptURL string) PageOption {
  return func(ctx context.Context, cfg *pageConfig) {
     cfg.scripts = append(cfg.scripts, scriptURL)
  }
}

func WithStylesheet(stylesheetURL string) PageOption {
  return func(ctx context.Context, cfg *pageConfig) {
     cfg.stylesheets = append(cfg.stylesheets, stylesheetURL)
  }
}

templ html(cfg pageConfig) {
  <html>
    <head>
      <title>{cfg.title}</title>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      for _, script := range cfg.scripts {
      <script src={script}></script>
      }
      for _, stylesheet := range cfg.stylesheets {
      <link rel="stylesheet" href={stylesheet} />
      }
    </head>
    <body>
      { children... }
    </body>
  </html>
}

type BlogListData struct {
  Blog  blog.Blog
  Posts []*blog.PostMetadata
}

templ BlogPage(data BlogListData, options ...PageOption) {
  {{
    cfg := pageConfig{}
    for _, opt := range options {
      opt(ctx, &cfg)
    }
  }}

  @html(cfg) {
    <main class="max-w-(--content-width) mx-auto">
      <div class="bg-red-500/25 aspect-3/1 w-full"></div>
      <div class="max-w-(--text-width) px-4 mx-auto mt-6 space-y-2">
        <h1 class="text-5xl font-bold">
          {data.Blog.Title}
        </h1>
        <p class="text-gray-700 text-lg">
          {data.Blog.Summary}
        </p>
      </div>
      <div class="max-w-(--text-width) mx-auto mt-8 space-y-8">
        @postList(data)
      </div>
    </main>
  }
}

templ postList(data BlogListData) {
  for _, post := range data.Posts {
    <a href={data.Blog.PostURL(*post)} class="block space-y-2">
      <div class="bg-blue-500/25 aspect-3/1 w-full"></div>
      <div class="px-4 space-y-1">
        <h2 class="text-3xl font-semibold">
          {post.Title}
        </h2>
        <p class="text-gray-700 text-lg line-clamp-3">
          {post.Summary}
        </p>
      </div>
    </a>
  }
}

type PostData struct {
  Post blog.Post
}

templ PostPage(data PostData, options ...PageOption) {
  {{
    cfg := pageConfig{}
    for _, opt := range options {
      opt(ctx, &cfg)
    }
    metadata := data.Post.Metadata()
  }}

  @html(cfg) {
    <main class="max-w-(--content-width) mx-auto">
      <div class="bg-blue-500/25 aspect-3/1 w-full"></div>
      <div class="max-w-(--text-width) px-4 mx-auto mt-6 space-y-2">
        <h1 class="text-5xl font-bold">
          {metadata.Title}
        </h1>
      </div>
      <article class="prose mx-auto mt-8 space-y-8">
        @post(data.Post)
      </article>
    </main>
  }
}
