package components

import (
  "time"

  "github.com/untanky/homepage/internal/media"
)

templ html(cfg HtmlPage) {
  <html>
    <head>
      <title>{cfg.title}</title>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      for _, script := range cfg.scripts {
      <script defer src={script}></script>
      }
      for _, stylesheet := range cfg.stylesheets {
      <link rel="stylesheet" href={stylesheet} />
      }
      @metadata(cfg.metadata)
    </head>
    <body>
      { children... }
    </body>
  </html>
}

templ metadata(md PageMetadata) {
  <meta name="description" content={md.Description}/>
  <meta name="canonical" content={md.CanonicalURL}/>
  <meta name="author" content={md.Author}/>
  <meta name="robots" content={md.Robots}/>
  <meta property="og:type" content={md.Type}/>
  <meta property="og:title" content={md.Title}/>
  <meta property="og:description" content={md.Description}/>
  <meta property="og:image" content={md.Image}/>
  <meta property="og:url" content={md.CanonicalURL}/>
  <meta property="og:site_name" content={md.Site}/>
  <meta property="article:published_time" content={md.PublishedAt.Format(time.RFC3339)}/>
  <meta property="article:author" content={md.Author} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@untanky" />
  <meta name="twitter:creator" content="@untanky" />
  <meta name="twitter:title" content={md.Title}/>
  <meta name="twitter:description" content={md.Description}/>
  <meta name="twitter:image" content={md.Image}/>
}

templ pageHeader(image media.Asset) {
  <div class="aspect-3/1 w-full overflow-hidden border-2 border-black">
    @Image(image, 840)
  </div>
}

type ShareData struct {
  Title string
  URL string
}

templ shareButton(data ShareData) {
  <button
    data-share-title={data.Title}
    data-share-url={data.URL}
    class="share border-0"
  >
    Share
  </button>
}
